javascript:(function() {
    var scripts = [
        // Có thể thêm nhiều link
        "https://cdn.jsdelivr.net/gh/Juzly2001/TicketBookmarklet@master/RFreshchat.js",
        "https://cdn.jsdelivr.net/gh/Juzly2001/TicketBookmarklet@master/ticket.js",
    ];

    scripts.forEach(function(url, index) {
        var s = document.createElement("script");
        s.id = "custom-script-" + index;
        s.src = url + "?v=" + Date.now();
        s.onload = function() {
            console.log("✅ Script loaded: " + url);
        };
        s.onerror = function() {
            console.error("❌ Failed to load: " + url);
        };
        document.body.appendChild(s);
    });
})();



